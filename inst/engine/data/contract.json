    {
      "id": "M03.normal",
      "status": "principal_model_restricted",
      "estimands": [
        "ATE",
        "ATT",
        "ATC",
        "ATO"
      ],
      "outcomes": [
        "continuous"
      ],
      "inputs": {
        "r": {
          "label": "Proporción tratada",
          "domain": "0 < r < 1",
          "unit": "dimensionless",
          "required": true
        },
        "phi": {
          "label": "Solapamiento Bhattacharyya",
          "domain": "0 < phi <= 1",
          "unit": "dimensionless",
          "required": true
        },
        "rho2": {
          "label": "Correlación al cuadrado con predictor de propensión",
          "domain": "0 <= rho2 < 1; require 0 if phi=1",
          "unit": "dimensionless",
          "required": true
        },
        "S": {
          "label": "Desviación marginal de Y(0), población original",
          "domain": "positive_finite",
          "unit": "outcome_units",
          "required": true
        },
        "delta": {
          "label": "Efecto de interés",
          "domain": "finite; nonzero for sample_size",
          "unit": "effect_scale",
          "required": true
        },
        "homogeneous_effect": {
          "label": "Efecto homogéneo para el modelo de planificación",
          "domain": "must_be_true",
          "unit": "dimensionless",
          "required": true
        },
        "estimand": {
          "label": "Población de interés",
          "domain": "ATE | ATT | ATC | ATO",
          "unit": "dimensionless",
          "required": true
        }
      },
      "variance_formula": "A=S^2*Vtilde; B=0; see equations in definitive specification",
      "functions": [
        "sample_size",
        "power",
        "precision",
        "minimum_detectable_effect"
      ],
      "source": "M03",
      "n_means": "total",
      "working_distribution": "Normal(mu,sigma2) for logit propensity; Beta-matched moments",
      "root": {
        "parameter": "log(k)",
        "a": "k*r",
        "b": "k*(1-r)",
        "equation": "phi=Gamma(a+0.5)/sqrt(a)/Gamma(a)*Gamma(b+0.5)/sqrt(b)/Gamma(b)",
        "bracket": "expand adaptively until opposite signs; no arbitrary a,b>=0.5 lower bound",
        "residual_tolerance": 1e-08
      },
      "moments": {
        "mu": "digamma(a)-digamma(b)",
        "sigma2": "trigamma(a)+trigamma(b)"
      },
      "tilts": {
        "ATE": "1",
        "ATT": "e",
        "ATC": "1-e",
        "ATO": "e*(1-e)"
      },
      "integration": {
        "variable": "standard Normal",
        "method": "adaptive quadrature with stable log integrands",
        "audit_method": "Gaussian quadrature",
        "tolerance": 1e-08,
        "failure": "numeric_failure"
      },
      "phi1": {
        "Vtilde": "1/(r*(1-r))",
        "rho2": "undefined correlation; use explicit constant branch"
      },
      "restrictions": [
        "no binary module in release1",
        "no literal logit-Beta integration",
        "do not assert conservative ordering for all WATE",
        "ATC obtained by group exchange"
      ],
      "variance_parameter_inputs": [
        "r",
        "phi",
        "rho2",
        "S",
        "homogeneous_effect",
        "estimand"
      ],
      "effect_input": "delta; omitted when solving MDE or precision"
    },
    {
      "id": "M06.prediction",
