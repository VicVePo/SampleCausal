      ],
      "inputs": {
        "n0": {
          "label": "Controles externos fijos",
          "domain": "positive_integer",
          "unit": "persons",
          "required": true
        },
        "p": {
          "label": "Covariables sin intercepto",
          "domain": "nonnegative_integer",
          "unit": "dimensionless",
          "required": true
        },
        "residual_var0": {
          "label": "Varianza residual externa",
          "domain": "positive_finite",
          "unit": "outcome_units_squared",
          "required": true
        },
        "residual_var1": {
          "label": "Varianza residual nueva",
          "domain": "positive_finite",
          "unit": "outcome_units_squared",
          "required": true
        },
        "delta": {
          "label": "Efecto de interés",
          "domain": "finite; nonzero for sample_size",
          "unit": "effect_scale",
          "required": true
        }
      },
      "variance_formula": "require n0>p+1; A=residual_var1+residual_var0*p/(n0-p-1); B=residual_var0/n0+residual_var0*p/(n0*(n0-p-1))",
      "functions": [
        "sample_size",
        "power",
        "precision",
        "minimum_detectable_effect"
      ],
      "source": "M06",
      "n_means": "new_treated",
      "restrictions": [
        "linear prediction model",
        "same covariate distribution; multivariate normal covariate derivation",
        "normal independent residuals",
        "unconditional historical-sample uncertainty",
        "no guarantee conditional on every observed historical dataset"
      ],
      "variance_parameter_inputs": [
        "n0",
        "p",
        "residual_var0",
        "residual_var1"
      ],
      "effect_input": "delta; omitted when solving MDE or precision"
    },
    {
      "id": "M05.summary",
      "status": "recruitment_complement",
      "estimands": [
        "externally_justified_matched_target"
      ],
      "outcomes": [
        "outcome_agnostic"
      ],
      "inputs": {
        "n_control": {
          "label": "Controles/pares objetivo previamente justificados",
          "domain": "positive_integer",
          "unit": "persons",
          "required": true
        },
        "n_treated_interim": {
          "label": "Tratados intermedios",
          "domain": "positive_integer <= n_control",
          "unit": "persons",
          "required": true
        },
        "mean_resampling_match_rate": {
          "label": "Tasa media procedente del remuestreo prescrito",
          "domain": "0 < rate <= 1",
          "unit": "dimensionless",
          "required": true
        },
        "alpha_ci": {
          "label": "Error para límite unilateral",
          "domain": "0 < alpha_ci < 0.5",
          "unit": "dimensionless",
          "required": true
        },
        "resampling_metadata": {
          "label": "Número de remuestreos, semilla, algoritmo/caliper y fallos",
          "domain": "required_metadata",
          "unit": "metadata",
          "required": true
        },
        "pair_target_justification": {
          "label": "Justificación compatible con análisis emparejado",
          "domain": "nonempty_text",
          "unit": "metadata",
          "required": true
        }
      },
      "variance_formula": "lower=rate-z_(1-alpha_ci)*sqrt(rate*(1-rate)/n_control); require lower>0; final=ceil(n_control/lower); additional=max(0,final-n_treated_interim)",
      "functions": [
        "recruitment_reestimation"
      ],
      "source": "M05",
      "n_means": "treated_total_and_additional",
      "restrictions": [
        "scalar summary step only",
        "interim equal-size 1:1 resampling without replacement",
        "does not fit propensity or perform matching",
        "does not independently establish causal power"
      ],
      "variance_parameter_inputs": [
        "n_control",
        "n_treated_interim",
        "mean_resampling_match_rate",
        "alpha_ci",
        "resampling_metadata",
        "pair_target_justification"
      ],
      "effect_input": "not_applicable"
    },
