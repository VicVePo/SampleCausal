{
  "project": "SampleCausal",
  "phase": 2,
  "version": "2.1",
  "date": "2026-09-26",
  "status": "specification_complete_implementation_pending",
  "supersedes": "SampleCausal_Fase2_Contrato.json",
  "defaults": {
    "test": "two_sided",
    "mode": "full_normal_integer",
    "experimental_enabled": false,
    "alpha_and_power": "visible examples only; require deliberate input or acceptance",
    "unknown_design_parameters": "never silently imputed"
  },
  "common_inputs": {
    "alpha": {
      "label": "Significación por prueba",
      "domain": "0 < alpha < 0.5",
      "unit": "dimensionless",
      "required": false,
      "when": "sample_size | power | minimum_detectable_effect"
    },
    "target_power": {
      "label": "Potencia objetivo",
      "domain": "0.5 < target_power < 1",
      "unit": "dimensionless",
      "required": false
    },
    "test": {
      "label": "Tipo de prueba",
      "domain": "two_sided | one_sided",
      "unit": "dimensionless",
      "required": false,
      "when": "sample_size | power | minimum_detectable_effect"
    },
    "direction": {
      "label": "Dirección unilateral",
      "domain": "increase | decrease",
      "unit": "dimensionless",
      "required": false
    },
    "calculation": {
      "label": "Resultado solicitado",
      "domain": "sample_size | power | precision | minimum_detectable_effect | recruitment_reestimation",
      "unit": "dimensionless",
      "required": true
    },
    "mode": {
      "label": "Aproximación utilizada",
      "domain": "full_normal_integer | quantile_formula",
      "unit": "dimensionless",
      "required": true,
      "default": "full_normal_integer"
    },
    "sample_size": {
      "label": "Muestra analizable",
      "domain": "positive_integer",
      "unit": "persons",
      "required": false
    },
    "loss": {
      "label": "Fracción adicional no evaluable",
      "domain": "0 <= loss < 1",
      "unit": "dimensionless",
      "required": false,
      "default": 0
    },
    "confidence": {
      "label": "Nivel de confianza para precisión",
      "domain": "0.5 < confidence < 1",
      "unit": "dimensionless",
      "required": false
    },
    "half_width": {
      "label": "Semianchura deseada",
      "domain": "positive_finite",
      "unit": "effect_scale",
      "required": false
    },
    "source_for_each_design_parameter": {
      "label": "Procedencia de las entradas",
      "domain": "pilot | publication | explicit_assumption | sensitivity_scenario",
      "unit": "metadata",
      "required": true
    },
    "effect_units": {
      "label": "Unidades/escala del efecto",
      "domain": "nonempty_text",
      "unit": "metadata",
      "required": true
    },
    "assumptions": {
      "label": "Compatibilidad con el diseño y estimador",
      "domain": "explicit_declarations",
      "unit": "metadata",
      "required": true
    }
  },
  "operation_input_rules": {
    "precedence": "These conditional rules override generic required flags; unsupported functions remain disabled.",
    "common_metadata": [
      "source_for_each_design_parameter",
      "effect_units",
      "assumptions"
    ],
    "sample_size": {
      "require": [
        "alpha",
        "target_power",
        "test",
        "mode",
        "module_variance_parameters",
        "effect"
      ],
      "solve": "sample_size",
      "do_not_require": [
        "sample_size",
        "confidence",
        "half_width"
      ],
      "direction": "require when one_sided; effect must match intended direction for target_power>0.5"
    },
    "power": {
      "require": [
        "alpha",
        "test",
        "sample_size",
        "module_variance_parameters",
        "effect"
      ],
      "solve": "power",
      "do_not_require": [
        "target_power",
        "confidence",
        "half_width"
      ],
      "direction": "require when one_sided; retain sign even when effect opposes direction; never use abs"
    },
    "precision": {
      "require": [
        "confidence",
        "half_width",
        "module_variance_parameters"
      ],
      "solve": "sample_size",
      "do_not_require": [
        "alpha",
        "target_power",
        "test",
        "direction",
        "sample_size",
        "delta"
      ],
      "note": "An outcome risk needed to determine variance remains required, even if delta itself is not."
    },
    "minimum_detectable_effect": {
      "require": [
        "alpha",
        "target_power",
        "test",
        "sample_size",
        "direction",
        "module_variance_parameters"
      ],
      "solve": "effect",
      "do_not_require": [
        "delta",
        "confidence",
        "half_width"
      ],
      "note": "Recompute variance along effect-dependent path; M01 binary solves p1 on specified branch."
    },
    "recruitment_reestimation": {
      "only_module": "M05.summary",
      "require": [
        "n_control",
        "n_treated_interim",
        "mean_resampling_match_rate",
        "alpha_ci",
        "resampling_metadata",
        "pair_target_justification"
      ],
      "solve": [
        "n_treated_final",
        "n_additional"
      ],
      "do_not_require": [
        "alpha",
        "target_power",
        "test",
        "mode",
        "sample_size",
        "delta",
        "confidence",
        "half_width",
        "loss",
        "effect_units"
      ]
    }
  },
  "modules": [
    {
      "id": "M01.weights",
      "status": "principal",
      "estimands": [
        "ATE"
      ],
      "outcomes": [
        "continuous",
        "binary"
      ],
      "inputs": {
        "r": {
          "label": "Proporción tratada",
          "domain": "0 < r < 1",
          "unit": "dimensionless",
          "required": true
        },
        "delta": {
          "label": "Efecto de interés",
          "domain": "finite; nonzero for sample_size",
          "unit": "effect_scale",
          "required": true
        },
        "sd0": {
          "label": "Desviación de Y(0)",
          "domain": "positive_finite",
          "unit": "outcome_units",
          "required": false,
          "when": "continuous"
        },
        "sd1": {
          "label": "Desviación de Y(1)",
          "domain": "positive_finite",
          "unit": "outcome_units",
          "required": false,
          "when": "continuous"
        },
        "p0": {
          "label": "Riesgo marginal potencial sin tratamiento",
          "domain": "0 < p0 < 1",
          "unit": "dimensionless",
          "required": false,
          "when": "binary"
        },
        "p1": {
          "label": "Riesgo marginal potencial con tratamiento",
          "domain": "0 < p1 < 1",
          "unit": "dimensionless",
          "required": false,
          "when": "binary; except MDE"
        },
        "D0": {
          "label": "Efecto de diseño Kish, controles",
          "domain": "D0 >= 1",
          "unit": "dimensionless",
          "required": true
        },
        "D1": {
          "label": "Efecto de diseño Kish, tratados",
          "domain": "D1 >= 1",
          "unit": "dimensionless",
          "required": true
        }
      },
      "variance_formula": "A=D1*var1/r+D0*var0/(1-r); B=0; binary: varz=pz*(1-pz), delta=p1-p0",
      "functions": [
        "sample_size",
        "power",
        "precision",
        "minimum_detectable_effect"
      ],
      "source": "M01",
      "n_means": "total",
      "restrictions": [
        "ATE Hajek IPTW",
        "weights-only approximation omits outcome remainder"
      ],
      "optional_weights_summary": {
        "per_arm": [
          "n_arm",
          "sum_w",
          "sum_w2"
        ],
        "D": "n_arm*sum_w2/sum_w^2",
        "domain": "n_arm positive integer; sum_w>0; sum_w2>0; D>=1"
      },
      "mde": "fix p0,r,D0,D1; branch by direction; recompute p1(1-p1) at each trial p1 in (0,1)",
      "variance_parameter_inputs": {
        "continuous": [
          "r",
          "sd0",
          "sd1",
          "D0",
          "D1"
        ],
        "binary": [
          "r",
          "p0",
          "p1",
          "D0",
          "D1"
        ],
        "binary_MDE": [
          "r",
          "p0",
          "D0",
          "D1"
        ]
      },
      "effect_input": "continuous: delta; binary: derive delta=p1-p0; reject conflicting supplied delta"
    },
    {
      "id": "M01.adjusted_variance",
      "status": "principal_advanced",
      "estimands": [
        "ATE"
      ],
      "outcomes": [
        "continuous"
      ],
      "inputs": {
        "r": {
          "label": "Proporción tratada",
          "domain": "0 < r < 1",
          "unit": "dimensionless",
          "required": true
        },
        "delta": {
          "label": "Efecto de interés",
          "domain": "finite; nonzero for sample_size",
          "unit": "effect_scale",
          "required": true
        },
        "q0": {
          "label": "Varianza ajustada, controles",
          "domain": "positive_finite",
          "unit": "outcome_units_squared",
          "required": true
        },
        "q1": {
          "label": "Varianza ajustada, tratados",
          "domain": "positive_finite",
          "unit": "outcome_units_squared",
          "required": true
        },
        "pilot_definition": {
          "label": "Estimador, población, tamaño y estimación de varianza",
          "domain": "required_metadata",
          "unit": "metadata",
          "required": true
        },
        "q_definition": {
          "label": "Definición exacta de la varianza ajustada",
          "domain": "M01_section6_sigma2_times_deff_with_remainder",
          "unit": "metadata",
          "required": true
        }
      },
      "variance_formula": "A=q1/r+q0/(1-r); B=0",
      "functions": [
        "sample_size",
        "power",
        "precision",
        "minimum_detectable_effect"
      ],
      "source": "M01",
      "n_means": "total",
      "restrictions": [
        "no second multiplication by D",
        "no automatic raw-pilot correction",
        "q is not SE and not raw outcome variance",
        "q must use M01 section6 definition for known-weight planning variance",
        "do not substitute marginal sandwich variances from joint propensity estimation; they may omit covariance of the contrast"
      ],
      "variance_parameter_inputs": [
        "r",
        "q0",
        "q1",
        "pilot_definition",
        "q_definition"
      ],
      "effect_input": "delta; omitted when solving MDE or precision"
    },
